# Copie para .env. Os valores abaixo funcionam para rodar localmente.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234

# Pelo menos 32 caracteres. Para gerar uma: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres

# Opcionais. Sem elas, valem os padrões abaixo.
# JWT_EXPIRATION=86400
# RESEND_API_KEY=
# RECONPAY_EMAIL_FROM=ReconPay <noreply@reconpay.local>
# RECONPAY_VERIFICATION_BASE_URL=http://localhost:3000
# RECONPAY_VERIFICATION_TOKEN_HOURS=24
# RECONPAY_CORS_ALLOWED_ORIGINS=http://localhost:3000
